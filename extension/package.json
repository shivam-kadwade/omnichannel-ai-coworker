{
  "name": "@coworker/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:firefox",
    "build:firefox": "tsc -b && BROWSER_TARGET=firefox vite build",
    "build:chrome": "tsc -b && BROWSER_TARGET=chrome vite build",
    "build:edge": "tsc -b && BROWSER_TARGET=edge vite build",
    "build:safari": "tsc -b && BROWSER_TARGET=safari vite build",
    "build:all": "npm run build:firefox && npm run build:chrome && npm run build:edge && npm run build:safari",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.50.1",
    "@copilotkit/react-ui": "^1.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
