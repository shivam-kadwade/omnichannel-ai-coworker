PORT=3001
# Set only for a private localhost demo. This bypasses Auth0 and uses a fixed demo identity.
LOCAL_DEMO_MODE=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.omnichannel-coworker.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
EXTENSION_ORIGIN=moz-extension://your-extension-id
OPENAI_API_KEY=replace-with-your-openai-api-key
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_WEBHOOK_TOKEN=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://your-public-backend.example.com
OTARI_BASE_URL=http://localhost:8000/api/v1
OTARI_API_KEY=your-otari-virtual-key
OTARI_MODEL=openrouter:openai/gpt-4o-mini
EXA_API_KEY=your-exa-api-key
AMBIGUOUS_API_KEY=your-ambiguous-workspace-api-key
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai
